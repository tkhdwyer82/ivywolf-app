# apps/mobile — copy to .env and fill in. EXPO_PUBLIC_* values are compiled into the app: never put a secret here.

# Clerk -> API keys -> publishable key (same instance as apps/web).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Supabase project rfzwtvysonwuuylveavq. The anon key only: every query carries the creator's Clerk JWT and RLS
# scopes it. The service role key never ships in the app.
EXPO_PUBLIC_SUPABASE_URL=https://rfzwtvysonwuuylveavq.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# apps/web base URL — the app calls POST /api/recordings/:id/process there to run the pipeline. No trailing slash.
EXPO_PUBLIC_API_URL=
