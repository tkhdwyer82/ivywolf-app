{
  "expo": {
    "name": "Ivy Wolf",
    "slug": "ivywolf",
    "scheme": "ivywolf",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "au.com.ivywolf.app",
      "appleTeamId": "PPC35J44SP",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Ivy records only after you tap record, so your spoken ideas can become cards."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F6F2EC"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ivy opens your library only when you add an image or video to your ideas.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withSceneLifecycle",
      [
        "expo-calendar",
        {
          "calendarPermission": "Ivy adds ideas with a time, like a shoot, to your calendar when you ask.",
          "remindersPermission": "Ivy adds to-dos you mention to Reminders when you turn on Add to Reminders."
        }
      ],
      "./plugins/withoutPush",
      "expo-notifications",
      "@bacons/apple-targets",
      "./plugins/withRecordShortcut"
    ]
  }
}
