# apps/web — copy to .env.local and fill in.
# Every var here is read by code currently in the repo. Nothing speculative.

# ── Clerk ──────────────────────────────────────────────────────────────────────
# Dashboard -> API keys. The publishable key is client-side; the secret key is not.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The Clerk Frontend API domain, e.g. "example.clerk.accounts.dev" or "clerk.ivywolf.com".
# Get it from https://clerk.com/setup/supabase — this is the same value that goes in
# supabase/config.toml under [auth.third_party.clerk], and it is what makes
# auth.jwt() ->> 'sub' resolve inside the RLS policies in 0001/0002/0004.
NEXT_PUBLIC_CLERK_DOMAIN=

# ── Supabase ───────────────────────────────────────────────────────────────────
# Project rfzwtvysonwuuylveavq (org IVYWOLF, Sydney).
NEXT_PUBLIC_SUPABASE_URL=https://rfzwtvysonwuuylveavq.supabase.co
# Anon key — used with the caller's Clerk token so RLS applies (lib/supabase.ts supabaseAsUser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — bypasses RLS. Only the Stripe webhook and the pipeline worker may use it.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in the dashboard.
STRIPE_WEBHOOK_SECRET=
# Price ids per plan (lib/billing.ts). Leave a plan's price unset to make it unpurchasable.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_BUNDLED12=

# ── App ────────────────────────────────────────────────────────────────────────
# Absolute base URL, used for Stripe success/cancel/return URLs. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Pipeline (POST /api/recordings/:id/process runs packages/pipeline in this app) ──────────────────────────
# Transcription (packages/pipeline/transcribe.ts).
DEEPGRAM_API_KEY=
# classify (packages/pipeline/classify.ts).
ANTHROPIC_API_KEY=
# Card embeddings for thread identity (packages/pipeline/embed.ts).
VOYAGE_API_KEY=
