{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["*.ts", "scripts/*.ts", "eval/*.ts", "generate/**/*.ts", "references/**/*.ts", "suggest/**/*.ts", "../schema/*.ts"]
}
