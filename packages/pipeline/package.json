{
  "name": "@ivywolf/pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "process.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "eval": "tsx --env-file=../../.env.local eval/run.ts",
    "ingest": "tsx --env-file=../../.env.local ingest.ts",
    "test": "tsx --test __tests__/*.test.ts",
    "eval:recipes": "tsx --env-file-if-exists=../../.env.local eval/recipes/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@supabase/supabase-js": "^2.116.0",
    "zod": "^4.6.5",
    "@ivywolf/schema": "*",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
